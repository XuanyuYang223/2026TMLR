    "python_program": "from pathlib import Path\nimport itertools,json,sys,tomllib\nimport numpy as np\nrepo=Path.cwd()\nsys.path.insert(0,str(repo/\"external/neurips/src\"))\nfrom neurips_permutations.math_ops import PROPERTY_FUNCTIONS,inverse,canonical_cycles\nbase=repo/\"diagnostics/permworld_answer_controls_20261109\"\nc=json.loads((base/\"math_classification.json\").read_text())\ntasks=c[\"tasks\"]; records=c[\"candidate_classification\"]\npassed=[True]*len(records); total=0\nfor n in range(1,9):\n ps=list(itertools.permutations(range(1,n+1))); lookup={p:i for i,p in enumerate(ps)}\n answers=np.array([[PROPERTY_FUNCTIONS[t](p) for t in tasks] for p in ps],dtype=np.int16)\n indexes={\"identity\":np.arange(len(ps)),\"complement\":np.array([lookup[tuple(n+1-v for v in p)] for p in ps]),\"inverse\":np.array([lookup[inverse(p)] for p in ps])}\n for i,entry in enumerate(records):\n  x=answers[:,tasks.index(entry[\"left_task\"])]; y=answers[indexes[entry[\"transform\"]],tasks.index(entry[\"right_task\"])]\n  passed[i] &= bool(np.all(y==x+entry[\"right_label_offset\"]))\n for p in ps:\n  assert canonical_cycles(inverse(p))==tuple((cy[0],*reversed(cy[1:])) for cy in canonical_cycles(p))\n  assert abs(PROPERTY_FUNCTIONS[\"peaks\"](p)-PROPERTY_FUNCTIONS[\"valleys\"](p))<=1\n total+=len(ps)\nfor result,entry in zip(passed,records):\n assert result==entry[\"finite_validation_passed\"],entry\n assert result==(entry[\"relation_id\"] is not None),entry\nassert total==46233 and len(records)==720\nprint(json.dumps({\"status\":\"passed\",\"permutations\":total,\"directed_candidate_rows\":len(records),\"known_exact_directions\":sum(passed)}))\n",
    "python_program_SHA256": "f120bf732b5d561492c6ce43a9882a1faa358b9bd2bc199541d244db5cd5ee19",
